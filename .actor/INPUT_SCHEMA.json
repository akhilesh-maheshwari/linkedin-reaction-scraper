{
  "title": "LinkedIn Post Reaction Scraper",
  "type": "object",
  "schemaVersion": 1,
  "properties": {
    "postUrl": {
      "title": "Post URL",
      "type": "string",
      "description": "LinkedIn post URL",
      "editor": "textfield",
      "default": "https://www.linkedin.com/posts/shishir-todi-1777561b6_jpmorgan-freshers-jobs-share-7491098621552062464-pTGt/?utm_source=share&utm_medium=member_desktop&rcm=ACoAADRKCzEBy5DUvWpd8xK9PiN5OH4WvMlQq2U"
    },
    "fileName": {
      "title": "Results File Name",
      "type": "string",
      "description": "Name of the output file",
      "editor": "textfield",
      "default": "linkedin-post-reaction-scraper-output"
    },
    "maxReactions": {
      "title": "Maximum number of reactions to scrape per each post",
      "type": "integer",
      "description": "Maximum reactions to fetch",
      "editor": "number",
      "default": 10
    }
  },
  "required": ["postUrl", "fileName"]
}
