{
  "title": "LinkedIn Post Reaction Scraper",
  "type": "object",
  "schemaVersion": 1,
  "properties": {
    "postUrl": {
      "title": "Post URL",
      "type": "string",
      "description": "LinkedIn post URL",
      "editor": "textfield",
      "default": "https://www.linkedin.com/posts/google_googleio-io25-gemini-activity-7330295765424046080-nSW4"
    },
    "fileName": {
      "title": "Results File Name",
      "type": "string",
      "description": "Name of the output file",
      "editor": "textfield",
      "default": "linkedin-post-reaction-scraper-output"
    },
    "maxReactions": {
      "title": "Maximum number of reactions to scrape per each post",
      "type": "integer",
      "description": "Maximum reactions to fetch",
      "editor": "number",
      "default": 10
    }
  },
  "required": ["postUrl", "fileName"]
}
